# ===== データベース =====
# 未設定の場合、ローカル埋め込みPostgres(PGlite: ./.pglite/data)で動作します。
# Neon作成後に接続文字列(pooled)を設定してください。
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ===== 認証 (Auth.js) =====
# `npx auth secret` または `openssl rand -base64 32` で生成
AUTH_SECRET=""

# Google OAuth (Google Cloud Console > APIとサービス > 認証情報)
# 未設定の場合、開発環境では名前+メールだけの開発用ログインが有効になります。
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# ===== Webプッシュ (VAPID) =====
# `npx web-push generate-vapid-keys` で生成
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:you@example.com"

# ===== Cron (リマインド・催促) =====
# /api/cron/* を保護するシークレット。Vercel Cron は Authorization: Bearer <CRON_SECRET> を自動付与。
# 未設定かつ本番では 401 になります(開発中は認証不要)。
# CRON_SECRET=""
